# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must never be committed.

# Supabase dashboard -> Project Settings -> API Keys (or "API" on older projects)

# The "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co

# The SECRET key. Shown as either "sb_secret_..." on newer projects
# or as the "service_role" JWT (eyJhbGci...) on older ones. Click "Reveal".
#
# Note there is deliberately no NEXT_PUBLIC_ prefix on either variable.
# That prefix bakes a value into the JavaScript sent to the browser, which
# for this key would publish full database access to the world.
SUPABASE_SECRET_KEY=sb_secret_replace_me
